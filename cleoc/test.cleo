import std.io.print

pub type Printable = trait {
    fn print()
}

type Foo = struct {
    a: i32,
}

fn print(self: *Foo) {
    print("Foo::a = {}", self.a)
}

fn main() {
    var foo = Foo { .a = 42 }
    var b: u32 = 10
    const c = 42

    b = c + 8

    if foo.a > b as u32 {
        print("foo.a is greater than b")
    } else {
        print("foo.a is not greater than b")
    }
}

