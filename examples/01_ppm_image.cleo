
type File = c_void

@extern
@no_emit
proc fopen(path: *const u8, mode: *const u8) *File

@extern
@no_emit
proc fclose(fptr: *File)

@extern
@no_emit
proc fprintf(file: *File, content: *const u8)

@extern
@no_emit
proc malloc(size: u64) *c_void

proc offset(str: *u8, index: u64) *u8 { cast[*u8]((cast[u64](str) + index)) }

proc set(str: *u8, index: u64, ch: u8) { 
    *offset(str, index) = ch
}

proc at(str: *u8, index: u64) u8 { *offset(str, index) }

proc u8_to_str(value: u8, out: *u8) {
    ptr: *u8 = cast[*u8](out)

    if (value >= 100u8) {
        set(ptr, 0u64, (value / 100u8) + 48u8)
        set(ptr, 1u64, ((value / 10u8) % 10u8) + 48u8)
        set(ptr, 2u64, (value % 10u8) + 48u8)
        set(ptr, 3u64, 0u8)
    } else {
        if (value >= 10u8) {
            set(ptr, 0u64, (value / 10u8) + 48u8)
            set(ptr, 1u64, (value % 10u8) + 48u8)
            set(ptr, 2u64, 0u8)
        } else {
            set(ptr, 0u64, value + 48u8)
            set(ptr, 1u64, 0u8)
        }
    }
}

proc print_color(file: *File, color: u8) {
    buff: [4]u8
    u8_to_str(color, cast[*u8](&buff))
    fprintf(file, cast[*u8](&buff))
}

proc write_image(file: *File, colors: *u8, rows: u64, cols: u64) {
    fprintf(file, cast[*u8](&"P3\n"))
    fprintf(file, cast[*u8](&"255 255\n"))
    
    fprintf(file, cast[*u8](&"255\n"))
    
    total_bytes: u64 = rows * cols * 3u64
    i: u64 = 0u64

    loop {
        if i >= total_bytes {
            break
        }

        print_color(file, at(colors, i))
        fprintf(file, cast[*u8](&" "))
        
        print_color(file, at(colors, i + 1u64))
        fprintf(file, cast[*u8](&" "))

        print_color(file, at(colors, i + 2u64))
        fprintf(file, cast[*u8](&"\n"))

        i += 3u64
    }
}

proc generate_test_gradient(colors: *u8, rows: u64, cols: u64) {
    y: u64 = 0u64
    loop {
        if y >= rows { break }

        x: u64 = 0u64
        loop {
            if x >= cols { break }

            index: u64 = ((y * cols) + x) * 3u64

            set(colors, index, cast[u8](x))
            set(colors, index + 1u64, cast[u8](y))
            set(colors, index + 2u64, 64u8)

            x += 1u64
        }
        y += 1u64
    }
}

proc main() {
    rows: u64 = 255u64
    cols: u64 = 255u64

    colors: *u8 = cast[*u8](malloc(3u64 * cols * rows))

    generate_test_gradient(colors, rows, cols)

    file: *File = fopen(
        cast[*u8](&"test.ppm"),
        cast[*u8](&"w")
    )

    write_image(file, colors, cols, rows)

    fclose(file)
}
