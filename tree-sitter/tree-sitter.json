{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "cleo",
      "camelcase": "Cleo",
      "title": "Cleo",
      "scope": "source.cleo",
      "file-types": [
        "cleo"
      ],
      "injection-regex": "^cleo$",
      "class-name": "TreeSitterCleo"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Parser for Cleo programming language",
    "authors": [
      {
        "name": "Daril Rodriguez",
        "email": "me@daril.dev",
        "url": ""
      }
    ],
    "links": {
      "repository": "https://github.com/tree-sitter/tree-sitter-cleo",
      "funding": ""
    }
  },
  "bindings": {
    "c": true,
    "go": false,
    "java": false,
    "node": true,
    "python": false,
    "rust": true,
    "swift": false,
    "zig": true
  }
}